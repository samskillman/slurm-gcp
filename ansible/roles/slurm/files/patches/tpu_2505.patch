diff --git a/src/plugins/job_submit/tpu/job_submit_tpu.c b/src/plugins/job_submit/tpu/job_submit_tpu.c
new file mode 100644
index 0000000000..c5a4f100d1
--- /dev/null
+++ b/src/plugins/job_submit/tpu/job_submit_tpu.c
@@ -0,0 +1,137 @@
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include "slurm/slurm_errno.h"
+#include "src/common/slurm_xlator.h"
+
+#include "src/common/log.h"
+#include "src/common/xmalloc.h"
+#include "src/common/xstring.h"
+#include "src/slurmctld/slurmctld.h"
+
+/* Required Slurm plugin symbols: */
+const char plugin_name[] = "Job submit tpu plugin";
+const char plugin_type[] = "job_submit/tpu";
+const uint32_t plugin_version = SLURM_VERSION_NUMBER;
+
+static int _process_tpu_slice(job_desc_msg_t *job_desc, char **err_msg)
+{
+	if (!job_desc->tpu_slice)
+		return SLURM_SUCCESS;
+
+	/* Parse job_desc->tpu_slice expected format [TYPE]:[TOPOLOGY] */
+	char *tpu_str = xstrdup(job_desc->tpu_slice);
+	char *colon = strchr(tpu_str, ':');
+
+	if (!colon) {
+		error("job_submit/tpu: Invalid tpu-slice format (%s). Expected [TYPE]:[TOPOLOGY]", job_desc->tpu_slice);
+		if (err_msg)
+			*err_msg = xstrdup("Invalid tpu-slice format. Expected [TYPE]:[TOPOLOGY]");
+		xfree(tpu_str);
+		return SLURM_ERROR;
+	}
+
+	*colon = '\0';
+	char *tpu_type = tpu_str;
+	char *tpu_topology = colon + 1;
+
+	info("job_submit/tpu: DEMO LOG: Received slice request %s:%s", tpu_type, tpu_topology);
+
+	/* Compute node count and properties depending on TPU generation */
+	int x = 0, y = 0, z = 0;
+	uint32_t num_nodes = 0;
+	uint32_t num_chips = 0;
+	uint32_t tres_count = 1;
+
+	if (xstrcmp(tpu_type, "v6e") == 0) {
+		/* v6e is 2D (XxY) and has 4 chips per node. Max slice 16x16 (256 chips / 64 nodes) */
+		if (sscanf(tpu_topology, "%dx%d", &x, &y) == 2 ||
+		    sscanf(tpu_topology, "%d_%d", &x, &y) == 2) {
+			num_chips = x * y;
+			num_nodes = num_chips / 4;
+			tres_count = (num_chips < 4) ? (num_chips == 0 ? 1 : num_chips) : 4;
+			if (num_nodes > 0 && num_nodes <= 64) {
+				job_desc->min_nodes = num_nodes;
+				job_desc->max_nodes = num_nodes;
+			} else {
+				info("job_submit/tpu: FAILURE: Invalid v6e topology %s. Allowed sizes up to 16x16 (64 nodes).", tpu_topology);
+				if (err_msg) *err_msg = xstrdup_printf("Invalid v6e topology %s.", tpu_topology);
+				xfree(tpu_str);
+				return SLURM_ERROR;
+			}
+		} else {
+			info("job_submit/tpu: FAILURE: Invalid v6e format %s. Expected 2D (XxY).", tpu_topology);
+			if (err_msg) *err_msg = xstrdup_printf("Invalid v6e format %s. Expected 2D (XxY).", tpu_topology);
+			xfree(tpu_str);
+			return SLURM_ERROR;
+		}
+	} else if (xstrcmp(tpu_type, "tpu7x") == 0) {
+		/* tpu7x is 3D (XxYxZ), 4 chips per node. Max defined super slice starts at 16 nodes (64 chips max bound for OR lists) */
+		if (sscanf(tpu_topology, "%dx%dx%d", &x, &y, &z) == 3 ||
+		    sscanf(tpu_topology, "%d_%d_%d", &x, &y, &z) == 3) {
+			num_chips = x * y * z;
+			num_nodes = num_chips / 4;
+			tres_count = (num_chips < 4) ? (num_chips == 0 ? 1 : num_chips) : 4;
+
+			if (num_nodes > 0) {
+				if (num_nodes == 1 || num_nodes == 2 || num_nodes == 4 || num_nodes == 8 || (num_nodes >= 16 && (num_nodes % 16 == 0))) {
+					job_desc->min_nodes = num_nodes;
+					job_desc->max_nodes = num_nodes;
+
+				} else {
+					info("job_submit/tpu: FAILURE: Invalid TPU v7x node count: %u. Allowed sizes are 1, 2, 4, 8, or multiples of 16.", num_nodes);
+					if (err_msg) *err_msg = xstrdup_printf("Invalid TPU v7x node count: %u. Allowed sizes: 1, 2, 4, 8, or multiples of 16.", num_nodes);
+					xfree(tpu_str);
+					return SLURM_ERROR;
+				}
+			} else {
+				info("job_submit/tpu: FAILURE: Invalid TPU v7x topology %s.", tpu_topology);
+				if (err_msg) *err_msg = xstrdup_printf("Invalid TPU v7x topology %s.", tpu_topology);
+				xfree(tpu_str);
+				return SLURM_ERROR;
+			}
+		} else {
+			info("job_submit/tpu: FAILURE: Invalid tpu7x format %s. Expected 3D (XxYxZ).", tpu_topology);
+			if (err_msg) *err_msg = xstrdup_printf("Invalid tpu7x format %s. Expected 3D (XxYxZ).", tpu_topology);
+			xfree(tpu_str);
+			return SLURM_ERROR;
+		}
+	} else {
+		info("job_submit/tpu: FAILURE: Unknown TPU generation %s.", tpu_type);
+		if (err_msg) *err_msg = xstrdup_printf("Unknown TPU generation %s.", tpu_type);
+		xfree(tpu_str);
+		return SLURM_ERROR;
+	}
+
+
+	/* Append to GRES (tres_per_node) */
+	if (job_desc->tres_per_node) {
+		char *new_tres = xstrdup_printf("%s,gres/tpu:%s:%u", job_desc->tres_per_node, tpu_type, tres_count);
+		xfree(job_desc->tres_per_node);
+		job_desc->tres_per_node = new_tres;
+	} else {
+		job_desc->tres_per_node = xstrdup_printf("gres/tpu:%s:%u", tpu_type, tres_count);
+	}
+
+
+	debug("job_submit/tpu: Computed tpu_slice %s -> tres_per_node=%s features=%s min_nodes=%u",
+	      job_desc->tpu_slice, job_desc->tres_per_node, job_desc->features, job_desc->min_nodes);
+
+	xfree(tpu_str);
+	return SLURM_SUCCESS;
+}
+
+extern int job_submit(job_desc_msg_t *job_desc, uint32_t submit_uid,
+		      char **err_msg)
+{
+	return _process_tpu_slice(job_desc, err_msg);
+}
+
+extern int job_modify(job_desc_msg_t *job_desc, job_record_t *job_ptr,
+		      uint32_t submit_uid, char **err_msg)
+{
+	return _process_tpu_slice(job_desc, err_msg);
+}
